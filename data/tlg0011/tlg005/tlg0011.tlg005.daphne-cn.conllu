# sent_id = tlg0011.tlg005.328
# text = καὶ μή με πλούτου τοῦ παρόντος εἴ τινες δόλοισι βουλεύουσιν ἐκβαλεῖν, ἐφῇς, ἀλλ’ ὧδέ μ’ αἰεὶ ζῶσαν ἀβλαβεῖ βίῳ δόμους Ἀτρειδῶν σκῆπτρά τ’ ἀμφέπειν τάδε, φίλοισί τε ξυνοῦσαν οἷς ξύνειμι νῦν εὐημεροῦσαν καὶ τέκνων ὅσων ἐμοὶ δύσνοια μὴ πρόσεστιν ἢ λύπη πικρά.
# translation_lang = zh
# prose_translation = 并且，如果有人用诡计谋划要剥夺我现有的财富，请不要允许这样的事发生；相反，让我永远在这里，过着无害的生活，侍奉阿特柔斯家族的这些宫殿和权杖，与我现在往来的朋友们相处融洽，生活顺遂，而对于那些孩子，只要他们对我没有敌意或痛苦的悲伤。
# literal_translation = 和 不 我 财富 这 现在的 如果 某些人 诡计 谋划 驱逐 , 你允许 , 但是 _ 如此 我 永远 活着 无害的 生活 房屋 阿特柔斯家族 权杖 和 照料 这些 , 朋友们 和 相处 那些人 我交往 现在 顺利 和 孩子们 那些 对我 恶意 不 存在 或 悲伤 苦涩的 .
